{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "chrome", "node"],
    "paths": {
      "@src/*": ["./src/*"],
      "@tests/*": ["./src/__tests__/*"]
    }
  }
}
