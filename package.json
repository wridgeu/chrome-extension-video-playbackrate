{
  "name": "cbe-vpr",
  "version": "1.8.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Chrome extension to adjust the playback speed of videos",
  "repository": {
    "type": "git",
    "url": "https://github.com/wridgeu/chrome-extension-video-playbackrate.git"
  },
  "type": "module",
  "scripts": {
    "build": "npm run cleanup && vite build",
    "build:watch": "npm run cleanup && vite build --watch",
    "cleanup": "rimraf --glob dist *.dist.zip",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "prepare": "husky",
    "zip": "npm-build-zip --name=dist --source=./dist",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --coverage --project unit",
    "test:e2e": "vitest run --project e2e",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "pretest:e2e": "npm run build"
  },
  "keywords": [
    "Chrome Extension",
    "Video Speed Adjustments",
    "Browser Extension",
    "Extension"
  ],
  "author": "Marco Beier",
  "license": "Beerware",
  "devDependencies": {
    "@types/chrome": "^0.3.8",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "npm-build-zip": "^2.0.1",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "puppeteer": "^25.18.1",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@ui5/webcomponents": "^2.29.0",
    "@ui5/webcomponents-base": "^2.29.0",
    "@ui5/webcomponents-theming": "^2.29.0"
  },
  "allowScripts": {
    "puppeteer@25.18.1": true
  }
}
