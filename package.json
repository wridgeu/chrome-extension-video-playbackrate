{
  "name": "cbe-vpr",
  "version": "1.6.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Some experiment with browser extensions.",
  "repository": {
    "type": "git",
    "url": "https://github.com/wridgeu/chrome-extension-video-playbackrate.git",
    "directory": "src"
  },
  "type": "module",
  "scripts": {
    "build": "npm run cleanup && vite build",
    "build:watch": "npm run cleanup && vite build --watch",
    "cleanup": "rimraf --glob dist *.dist.zip",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "prepare": "husky",
    "zip": "npm-build-zip --name=dist --source=./dist",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --coverage --project unit",
    "test:e2e": "vitest run --project e2e",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "Chrome Extension",
    "Video Speed Adjustments",
    "Browser Extension",
    "Extension"
  ],
  "author": "Marco Beier",
  "license": "Beerware",
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "npm-build-zip": "^2.0.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "puppeteer": "^25.16.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@ui5/webcomponents": "^2.28.1",
    "@ui5/webcomponents-base": "^2.28.1"
  },
  "allowScripts": {
    "puppeteer@25.16.0": true
  }
}
